# ==============================================================================
# Переменные окружения BEINI Gateway (12-Factor App Configuration)
# Скопируйте этот файл в .env и укажите реальные параметры.
# НЕ коммитьте .env в Git!
# ==============================================================================

# Порт HTTP-сервера шлюза
PORT=8080

# Часовой пояс сервера
TZ=Europe/Moscow

# Учетные данные подключения к iikoCloud API (получаются в iikoWeb / Интеграции)
IIKO_API_BASE_URL=https://api-ru.iiko.services
IIKO_API_KEY=your_api_login_key_here
IIKO_APP_ID=00000000-0000-0000-0000-000000000000
IIKO_CLIENT_SECRET=your_base64_client_secret_here

# Идентификаторы ресторана и кассы (GUID из iikoWeb)
IIKO_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
IIKO_TERMINAL_GROUP_ID=00000000-0000-0000-0000-000000000000

# Город по умолчанию для геокодинга адресов доставки
DELIVERY_CITY=Назрань

# Таймаут передачи заказа на терминал iikoFront (в секундах)
TRANSPORT_TIMEOUT_SEC=60

# Секретный токен для эндпоинта /api/test-order
# Оставьте пустым, чтобы разрешить тесты только с 127.0.0.1 / localhost
# Для удаленного тестирования задайте надежную случайную строку
TEST_ORDER_TOKEN=change_this_to_a_secret_random_token_for_remote_tests

