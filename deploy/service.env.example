HTTP_LISTEN_ADDR=127.0.0.1:8080
STATIC_DIR=/opt/beini/current/public
BEINI_STATE_DIR=/var/lib/beini
ALLOWED_ORIGINS=https://beinirest.ru,https://www.beinirest.ru
TZ=Europe/Moscow
# closed (default), tester (owner only), public (guest checkout)
BEINI_ORDER_MODE=closed
# Configure only on the server, using scripts/tester-password.py --env.
# BEINI_TESTER_PASSWORD_HASH is intentionally absent from this example.
BEINI_TESTER_LOCAL_HTTP=0
